# Environment variables for the GTM Analytics project for local development

AIRFLOW_UID=50000

# MinIO authentication settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Airflow authentication settings
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW_ADMIN_PASSWORD=admin123

# Analytics PostgreSQL
ANALYTICS_POSTGRES_HOST=localhost
ANALYTICS_POSTGRES_PORT=5433
ANALYTICS_POSTGRES_USER=analytics
ANALYTICS_POSTGRES_PASSWORD=analytics_dev
ANALYTICS_POSTGRES_DB=analytics
ANALYTICS_POSTGRES_CONN=postgresql://${ANALYTICS_POSTGRES_USER}:${ANALYTICS_POSTGRES_PASSWORD}@${ANALYTICS_POSTGRES_HOST}:${ANALYTICS_POSTGRES_PORT}/${ANALYTICS_POSTGRES_DB}

# Airflow PostgreSQL (hostname used by Airflow containers)
AIRFLOW_POSTGRES_HOST=postgres
AIRFLOW_POSTGRES_PORT=5432
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_CONN=postgresql+psycopg2://${AIRFLOW_POSTGRES_USER}:${AIRFLOW_POSTGRES_PASSWORD}@${AIRFLOW_POSTGRES_HOST}:${AIRFLOW_POSTGRES_PORT}/${AIRFLOW_POSTGRES_DB}